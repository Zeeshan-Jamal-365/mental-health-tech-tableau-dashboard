        <calculation class='tableau' formula='IF LOWER([Gender]) = &quot;m&quot; OR&#13;&#10;   LOWER([Gender]) = &quot;male&quot; OR&#13;&#10;   CONTAINS(LOWER([Gender]), &quot;cis male&quot;) OR&#13;&#10;   CONTAINS(LOWER([Gender]), &quot;man&quot;)  &#13;&#10;THEN &quot;Male&quot;&#13;&#10;ELSEIF LOWER([Gender]) = &quot;f&quot; OR&#13;&#10;       LOWER([Gender]) = &quot;female&quot; OR&#13;&#10;       CONTAINS(LOWER([Gender]), &quot;cis female&quot;) OR&#13;&#10;       CONTAINS(LOWER([Gender]), &quot;woman&quot;)&#13;&#10; THEN &quot;Female&quot;&#13;&#10;ELSE &quot;Other&quot;&#13;&#10;END' />
      </column>
      <column caption='percent_treated' datatype='real' default-format='p0%' name='[Calculation_1096345057169522692]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='count(IF [treatment] == &quot;Yes&quot; THEN 1 END) / count([treatment])' />
      </column>
      <column caption='percent_family_history' datatype='real' default-format='p0%' name='[Calculation_2580844084460355584]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [family_history]=&quot;Yes&quot; THEN 1 END) / COUNT([family_history])' />
      </column>
      <column caption='percent_work_interference' datatype='real' default-format='p0%' name='[Calculation_2580844084465950722]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [work_interfere] in (&quot;Sometimes&quot;, &quot;Often&quot;) THEN 1 END) / count([work_interfere])' />
      </column>
      <column caption='percent_benefits' datatype='real' default-format='p0%' name='[Calculation_2580844084477235203]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(if [benefits] = &quot;Yes&quot; THEN 1 END) / COUNT([benefits])' />
      </column>
      <column caption='percent_fear_disclosure' datatype='real' default-format='p0%' name='[Calculation_2580844084480929796]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(if [mental_health_consequence]=&quot;Yes&quot; then 1 end)/count([mental_health_consequence])' />
      </column>
      <column caption='Dummy' datatype='string' name='[Calculation_2580844084484304903]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;placeholder&quot;' />
      </column>
      <column caption='Placeholder' datatype='string' name='[Calculation_2580844084485509128]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;placeholder&quot;' />
      </column>
      <column caption='KPI Index' datatype='integer' name='[Calculation_2580844084485738505]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='KPI Label' datatype='string' name='[Calculation_2580844084486791178]' role='measure' type='nominal'>
        <calculation class='tableau' formula='CASE [Calculation_2580844084485738505]&#13;&#10;WHEN 1 THEN &quot;🧠 Treated&quot;&#13;&#10;WHEN 2 THEN &quot;👪 Family History&quot;&#13;&#10;WHEN 3 THEN &quot;💼 Affects Work&quot;&#13;&#10;WHEN 4 THEN &quot;🏢 Benefits&quot;&#13;&#10;WHEN 5 THEN &quot;🚫 Fear Disclosure&quot;&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='KPI Value' datatype='real' name='[Calculation_2580844084486897675]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Calculation_2580844084485738505]&#13;&#10;WHEN 1 THEN COUNT(IF [treatment] = &quot;Yes&quot; THEN 1 END) / COUNT([treatment])&#13;&#10;WHEN 2 THEN COUNT(IF [family_history] = &quot;Yes&quot; THEN 1 END) / COUNT([family_history])&#13;&#10;WHEN 3 THEN COUNT(IF [work_interfere] IN (&quot;Sometimes&quot;, &quot;Often&quot;) THEN 1 END) / COUNT([work_interfere])&#13;&#10;WHEN 4 THEN COUNT(IF [benefits] = &quot;Yes&quot; THEN 1 END) / COUNT([benefits])&#13;&#10;WHEN 5 THEN COUNT(IF [mental_health_consequence] = &quot;Yes&quot; THEN 1 END) / COUNT([mental_health_consequence])&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Age Group' datatype='string' name='[Calculation_2580844084522016782]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Age] &lt; 25 THEN &quot;Under 25&quot;&#13;&#10;ELSEIF [Age] &lt;= 34 THEN &quot;25-34&quot;&#13;&#10;ELSEIF [Age] &lt;= 44 THEN &quot;35-44&quot;&#13;&#10;ELSEIF [Age] &lt;= 54 THEN &quot;45-54&quot;&#13;&#10;ELSE &quot;55+&quot;&#13;&#10;END' />
      </column>
      <column caption='Record Count' datatype='integer' name='[Calculation_2580844084591390735]' role='measure' type='quantitative'>
